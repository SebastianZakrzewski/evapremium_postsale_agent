# Copy to `.env` for local development (`.env` is gitignored).
# See project agent orchestration for how these are read.

# HTTP port (optional; default 3000 in main.ts)
PORT=3000

# LangChain chat model id passed to createAgent (optional; code has a default)
POSTSALE_AGENT_CHAT_MODEL=openai:gpt-4o-mini

# OpenAI API key when using OpenAI-backed models
OPENAI_API_KEY=

# Optional LangSmith tracing (see https://docs.langchain.com/langsmith/env-var)
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=
